APP_NAME="Presensi Cafe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=presensi_cafe
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=public

# ==========================================
# Konfigurasi khusus sistem presensi cafe
# ==========================================

# URL Python face recognition service (Bagian 3)
FACE_RECOGNITION_SERVICE_URL=http://localhost:8001

# Catatan: KIOSK_DEVICE_TOKEN sudah TIDAK dipakai lagi sejak fitur multi-cabang.
# Tiap cabang punya kiosk_token sendiri, auto-generate & bisa dilihat di /admin/cabang.

# Ambang batas menit lewat jam shift sebelum dianggap lembur (default 30)
AMBANG_LEMBUR_MENIT=30

# ==========================================
# Langganan
# ==========================================
LANGGANAN_TRIAL_HARI=14
LANGGANAN_GRACE_HARI=3
FRONTEND_URL=http://localhost:3000

# Rekening transfer manual (alternatif selain Midtrans)
LANGGANAN_BANK=BCA
LANGGANAN_REKENING_NOMOR=1234567890
LANGGANAN_KODE_UNIK=true
LANGGANAN_REKENING_NAMA="PT Contoh Presensi"

# Midtrans (akun platform, sama seperti KasirHub). Kosongkan untuk mematikan bayar online.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
